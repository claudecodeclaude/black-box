# Copy this file to .env.local (which is gitignored) and fill in real values.
# Required for scripts/fetch-reddit.ts.

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=black-box-research/0.1 by u/Chance_Awareness_513

# Office Texts (Twilio + Go High Level) — replaces Dial My Calls.
# TWILIO_AUTH_TOKEN signs the inbound webhook so we know it's really Twilio.
# GHL_API_TOKEN is a private integration token from a sub-account in Go High
# Level; GHL_LOCATION_ID is that sub-account's id.
TWILIO_AUTH_TOKEN=
GHL_API_TOKEN=
GHL_LOCATION_ID=
